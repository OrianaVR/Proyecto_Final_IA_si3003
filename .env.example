# Proveedor LLM con API compatible con OpenAI (/chat/completions). Copia este archivo a .env y completa.
# El archivo .env NO se sube a Git (está en .gitignore). Nunca pegues claves en el código ni en el README.
LLM_API_KEY=
# Si se deja vacío se usa https://api.openai.com/v1. Para otro proveedor compatible, pon su URL base
# (consúltala en su documentación), por ejemplo la de Groq, OpenRouter o Gemini en modo OpenAI.
LLM_BASE_URL=
# Modelo con soporte de llamadas a herramientas (tool calling).
LLM_MODEL=
